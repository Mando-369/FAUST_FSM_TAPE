//================= Streaming Hysteresis ===============
// Mode-selectable JA hysteresis with 9 bias presets.
//======================================================

//-----------------ja_hysteresis--------------------
// Streaming Jiles-Atherton hysteresis with bias preset selection.
// Uses 3×K29 cascaded LUT lookups (87 total substeps).
// Discrete selection (no crossfade between presets).
//
// #### Usage
//
// ```
// _ : ja_hysteresis(bias_preset) : _
// ```
//
// Where:
//
// * bias_preset: integer 0-8 selecting bias level (0=0.1, 4=0.5, 8=0.9)
//
// #### Example
//
// ```
// process = _ : ja_hysteresis(4);  // bias 0.5 (balanced)
// ```
//
// #### Test
//
// ```
// jah = library("jahysteresis_lite.lib");
// ja_hysteresis_test = os.osc(100) * 0.5 : jah.ja_hysteresis(4);
// ```
//
// #### References
//
// * Jiles, D.C. and Atherton, D.L. (1986) "Theory of ferromagnetic hysteresis"
//-------------------------------------------------
ja_hysteresis(bias_preset, H_in) = ba.selectn(9, mode,
    ja_hysteresis_3xK29_01(H_in),
    ja_hysteresis_3xK29_02(H_in),
    ja_hysteresis_3xK29_03(H_in),
    ja_hysteresis_3xK29_04(H_in),
    ja_hysteresis_3xK29_05(H_in),
    ja_hysteresis_3xK29_06(H_in),
    ja_hysteresis_3xK29_07(H_in),
    ja_hysteresis_3xK29_08(H_in),
    ja_hysteresis_3xK29_09(H_in))
with {
  mode = int(bias_preset + 0.5);
};

//================= FSM Channel Processing ===============
// Full Spectrum Magnetization channel with gain staging, drive, and mix.
//========================================================

//-----------------dc_blocker--------------------
// DC blocker (5 Hz highpass, Q=0.7071 Butterworth).
//
// #### Usage
//
// ```
// _ : dc_blocker : _
// ```
//-------------------------------------------------
dc_blocker = fi.SVFTPT.HP2(5.0, 0.7071);

//-----------------lambda_sat--------------------
// Wavelength saturation (spectral tilt) filter.
// Simulates shorter wavelengths saturating harder on tape.
//
// #### Usage
//
// ```
// _ : lambda_sat(alpha) : _
// ```
//
// Where:
//
// * alpha: tilt amount, -0.1 to +0.1 (0 = flat, + = HF boost before saturation)
//
// #### Example
//
// ```
// process = _ : lambda_sat(0.05) : _;
// ```
//-------------------------------------------------
lambda_sat(alpha) = fi.spectral_tilt(3, 200, 15000, alpha);

//-----------------fsm_channel--------------------
// Full Spectrum Magnetization channel with phase-locked Jiles-Atherton hysteresis.
// Uses 3×K29 cascaded LUT lookups for each of 9 bias presets.
// Applies input gain, drive, wavelength saturation, JA hysteresis,
// DC blocking, drive compensation, bias compensation, and output gain.
//
// #### Usage
//
// ```
// _ : fsm_channel(input_db, output_db, drive_db, mix, lambda_tilt, bias_preset) : _
// ```
//
// Where:
//
// * input_db: front-end gain in dB (-24 to +24)
// * output_db: post-stage gain in dB (-24 to +24)
// * drive_db: pre-saturation drive in dB (-18 to +29)
// * mix: dry/wet blend from 0 (dry) to 1 (wet)
// * lambda_tilt: wavelength saturation -0.1 to +0.1
// * bias_preset: integer 0-8 selecting bias level (0=0.1, 4=0.5, 8=0.9)
//
// #### Example
//
// ```
// process = par(i, 2, fsm_channel(0, 0, 6, 1, 0, 4));
// ```
//
// #### Test
//
// ```
// jah = library("jahysteresis_lite.lib");
// fsm_channel_test = os.osc(440) * 0.3 : jah.fsm_channel(0, 0, 6, 1, 0, 4);
// ```
//
// #### References
//
// * Jiles, D.C. and Atherton, D.L. (1986) "Theory of ferromagnetic hysteresis"
// * <https://github.com/Mando-369/FAUST_FSM_TAPE>
//-------------------------------------------------
fsm_channel(input_gain_db, output_gain_db, drive_db, mix_val,
            lambda_tilt, bias_preset) =
  ef.dryWetMixer(mix_val, wet_gained)
with {
  input_gain  = ba.db2linear(input_gain_db) : si.smoo;
  output_gain = ba.db2linear(output_gain_db) : si.smoo;
  drive_gain  = ba.db2linear(drive_db) : si.smoo;
  drive_comp  = (1.0 / drive_gain) * ba.db2linear(DRIVE_MAKEUP_DB);
  mode = int(bias_preset + 0.5);

  // Bias compensation per preset (measured)
  bias_comp_db = ba.selectn(9, mode,
    BIAS_COMP_01, BIAS_COMP_02, BIAS_COMP_03,
    BIAS_COMP_04, BIAS_COMP_05, BIAS_COMP_06,
    BIAS_COMP_07, BIAS_COMP_08, BIAS_COMP_09);
  bias_comp = ba.db2linear(bias_comp_db);

  fsm_stage(x) = x * input_gain
    : *(drive_gain)
    : lambda_sat(lambda_tilt)
    : ja_hysteresis(bias_preset)
    : dc_blocker
    : *(drive_comp)
    : *(bias_comp);

  wet_gained = fsm_stage : *(output_gain);
};

//-----------------fsm_channel_ui--------------------
// UI wrapper that binds sliders to the core `fsm_channel` parameters.
// Exposes bias preset as a knob (0-8 = bias 0.1-0.9).
//
// #### Usage
//
// ```
// _ : fsm_channel_ui : _
// ```
//
// #### Example
//
// ```
// process = par(i, 2, fsm_channel_ui);
// ```
//
// #### Test
//
// ```
// jah = library("jahysteresis_lite.lib");
// fsm_channel_ui_test = par(i, 2, jah.fsm_channel_ui);
// ```
//
// #### References
//
// * Jiles, D.C. and Atherton, D.L. (1986) "Theory of ferromagnetic hysteresis"
// * <https://github.com/Mando-369/FAUST_FSM_TAPE>
//-------------------------------------------------
fsm_channel_ui =
  fsm_channel(input_gain_db, output_gain_db, drive_db, mix, lambda_tilt, bias_preset)
with {
  bias_preset    = hgroup("JA Lite 3xK29", hgroup("[00] BIAS",
                    vslider("[0]Bias [style:knob]", 4, 0, 8, 1)));
  input_gain_db  = hgroup("JA Lite 3xK29", hgroup("[01] GAIN",
                    vslider("[0]Input [dB]", 0.0, -24.0, 24.0, 0.1)));
  output_gain_db = hgroup("JA Lite 3xK29", hgroup("[01] GAIN",
                    vslider("[1]Output [dB]", 0.0, -24.0, 24.0, 0.1)));
  drive_db       = hgroup("JA Lite 3xK29", hgroup("[01] GAIN",
                    vslider("[2]Drive [dB]", 0.0, -18.0, 29.0, 0.1)));
  mix            = hgroup("JA Lite 3xK29", hgroup("[01] GAIN",
                    vslider("[3]Mix", 1.0, 0.0, 1.0, 0.01)));
  lambda_tilt    = hgroup("JA Lite 3xK29", hgroup("[02] TAPE",
                    vslider("[0]Lambda Tilt", 0.0, -0.1, 0.1, 0.001)));
};
