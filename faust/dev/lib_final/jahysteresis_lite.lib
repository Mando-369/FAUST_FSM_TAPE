//############### jahysteresis_lite.lib ##################
// Jiles-Atherton Magnetic Hysteresis Library (LUT-Optimized)
//
// A FAUST library implementing the Jiles-Atherton model of ferromagnetic
// hysteresis — a physically-based mathematical description relating
// magnetization (M) to applied field (H). Combined with a phase-locked bias
// oscillator for analog tape emulation applications.
//
// This is the **LUT-optimized** version using 3×K29 cascaded lookups with
// 9 selectable bias presets (0.1-0.9). Each preset has its own precomputed LUT.
// CPU cost: <1% (vs ~2% for full-physics version).
//
// For the full-physics version with runtime-adjustable parameters,
// see `jahysteresis.lib`.
//
// * Constants
// * Cascaded Hysteresis Functions
// * Streaming Hysteresis
// * FSM Channel Processing
//
// It should be used using the `jah` environment:
//
// ```
// jah = library("jahysteresis_lite.lib");
// process = jah.fsm_channel_ui;
// ```
//
// #### References
//
// * Jiles, D.C. and Atherton, D.L. (1986) "Theory of ferromagnetic hysteresis"
// * Walters, S.J. "Full Spectrum Magnetization" (phase-locked bias oscillator)
// * <https://github.com/Mando-369/FAUST_FSM_TAPE>
//
//##################################################

declare name "Jiles-Atherton Hysteresis Library (LUT-Optimized)";
declare version "1.0.0";
declare author "Thomas Mandolini";
declare license "BSD";
declare copyright "2025 Thomas Mandolini";

// Its official prefix is `jah`.

import("stdfaust.lib");

// LUT imports for 9 bias presets (0.1-0.9)
// Each LUT uses H range [-40, 40] to cover full +29dB drive range
import("ja_lut_k29_bias_01.lib");
import("ja_lut_k29_bias_02.lib");
import("ja_lut_k29_bias_03.lib");
import("ja_lut_k29_bias_04.lib");
import("ja_lut_k29_bias_05.lib");
import("ja_lut_k29_bias_06.lib");
import("ja_lut_k29_bias_07.lib");
import("ja_lut_k29_bias_08.lib");
import("ja_lut_k29_bias_09.lib");

//================= Constants ===============
// Fixed parameters for LUT-optimized processing.
// 3×K29 = 87 total substeps with 3 course-corrections per sample.
//===========================================

INV_N = 1.0 / 87.0;
DRIVE_MAKEUP_DB = 15.6;

// Bias compensation per preset (measured values)
// Mode 0=0.1, 1=0.2, ... 8=0.9
BIAS_COMP_01 = -7.5;
BIAS_COMP_02 = -5.4;
BIAS_COMP_03 = -2.5;
BIAS_COMP_04 = 0.4;
BIAS_COMP_05 = 3.0;
BIAS_COMP_06 = 5.2;
BIAS_COMP_07 = 7.1;
BIAS_COMP_08 = 8.9;
BIAS_COMP_09 = 10.5;

//================= Cascaded Hysteresis Functions ===============
// 3×K29 cascaded LUT lookups for each bias preset.
// Each function performs 3 sequential lookups (M1→M2→M_end),
// totaling 87 effective substeps with 3 course-corrections per sample.
// Better transient response than single 2×K58.
//==============================================================

//-----------------ja_hysteresis_3xK29_01--------------------
// 3×K29 cascaded hysteresis for bias preset 0.1 (gritty).
//
// #### Usage
//
// ```
// _ : ja_hysteresis_3xK29_01 : _
// ```
//-------------------------------------------------
ja_hysteresis_3xK29_01(H) = (loop ~ _) : (!, _)
with {
  loop(recM) = M_end, Mavg with {
    M1 = ja_lookup_m_end_k29_bias_01(recM, H);
    s1 = ja_lookup_sum_m_rest_k29_bias_01(recM, H);
    M2 = ja_lookup_m_end_k29_bias_01(M1, H);
    s2 = ja_lookup_sum_m_rest_k29_bias_01(M1, H);
    M_end = ja_lookup_m_end_k29_bias_01(M2, H);
    s3 = ja_lookup_sum_m_rest_k29_bias_01(M2, H);
    Mavg = (s1 + s2 + s3) * INV_N;
  };
};

