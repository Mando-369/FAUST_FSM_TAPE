//############### jahysteresis.lib ##################
// Jiles-Atherton Magnetic Hysteresis Library
//
// A FAUST library implementing the Jiles-Atherton model of ferromagnetic
// hysteresis - a physically-based mathematical description relating
// magnetization (M) to applied field (H). Combined with a phase-locked bias
// oscillator for analog tape emulation applications.
//
// Full-physics implementation with runtime-adjustable parameters.
// Single mode: K72 (72 substeps, 3 integer cycles).
// CPU cost: ~2%.
//
// For the LUT-optimized multi-mode version (<1% CPU), see `jahysteresis_lite.lib`.
//
// * Physics Constants
// * JA Core Functions
// * Streaming Hysteresis
// * FSM Channel Processing
//
// It should be used using the `jah` environment:
//
// ```
// jah = library("jahysteresis.lib");
// process = jah.fsm_channel_ui;
// ```
//
// #### References
//
// * Jiles, D.C. and Atherton, D.L. (1986) "Theory of ferromagnetic hysteresis"
// * Walters, S.J. "Full Spectrum Magnetization" (phase-locked bias oscillator)
// * <https://github.com/Mando-369/FAUST_FSM_TAPE>
//
//##################################################

declare name "Jiles-Atherton Hysteresis Library";
declare version "1.1.0";
declare author "Thomas Mandolini";
declare license "BSD";
declare copyright "2025 Thomas Mandolini";

// Its official prefix is `jah`.

import("stdfaust.lib");

//================= Physics Constants ===============
// Default Jiles-Atherton model parameters.
// Ms = saturation magnetization, a = domain density,
// k = pinning (coercivity), c = reversibility, alpha = interdomain coupling.
//===================================================

MS_DEFAULT = 320.0;
A_DEFAULT = 720.0;
K_DEFAULT = 280.0;
C_DEFAULT = 0.18;
ALPHA_DEFAULT = 0.015;

BIAS_LEVEL_DEFAULT = 0.4;
BIAS_SCALE_DEFAULT = 11.0;
BIAS_ASYM_DEFAULT = 0.0;
DIFF_SCALE_DEFAULT = 1.0;
LAMBDA_TILT_DEFAULT = 0.0;

//================= JA Core Functions ===============
// Core Jiles-Atherton physics implementation.
// Full computation for all substeps (no LUT).
//===================================================

//-----------------ja_substep--------------------
// Single Jiles-Atherton substep computation.
// Computes magnetization change for one bias substep using the full JA model
// with soft-clamped pinning term for stability at high drive levels.
//
// #### Usage
//
// ```
// ja_substep(bias_offset, M_prev, H_prev, H_audio, params) : _,_
// ```
//
// Where:
//
// * bias_offset: bias oscillator value for this substep (typically sin(phase))
// * M_prev: magnetization from previous substep
// * H_prev: magnetic field from previous substep
// * H_audio: audio-rate magnetic field (input signal)
// * params: (bias_amp, inv_a_norm, alpha_norm, k_norm, c_norm, diff_scale, sigma)
//
// #### References
//
// * Jiles, D.C. and Atherton, D.L. (1986) "Theory of ferromagnetic hysteresis"
//-------------------------------------------------
ja_substep(bias_offset, M_prev, H_prev, H_audio,
           bias_amp, inv_a_norm, alpha_norm, k_norm, c_norm, diff_scale, sigma) = M_new, H_new
with {
  H_new = H_audio + bias_amp * bias_offset;
  dH    = H_new - H_prev;
  He    = H_new + alpha_norm * M_prev;

  x_man    = He * inv_a_norm;
  Man_e    = ma.tanh(x_man);
  Man_e2   = Man_e * Man_e;
  dMan_dH  = (1.0 - Man_e2) * inv_a_norm;

  // Soft clamp on (Man_e - M_prev) to stabilize pinning term
  diff = Man_e - M_prev;
  diff_clamped = diff / (1.0 + abs(diff) * diff_scale);

  dir      = ba.if(dH >= 0.0, 1.0, -1.0);
  pin      = dir * k_norm - alpha_norm * diff_clamped;
  inv_pin  = 1.0 / (pin + sigma);

  denom     = 1.0 - c_norm * alpha_norm * dMan_dH;
  inv_denom = 1.0 / (denom + 1e-9);
  dMdH      = (c_norm * dMan_dH + diff_clamped * inv_pin) * inv_denom;
  dM_step   = dMdH * dH;

  M_unclamped = M_prev + dM_step;
  M_new       = max(-1.0, min(1.0, M_unclamped));
};

//================= Streaming Hysteresis ===============
// Phase-locked bias oscillator with full JA computation.
// K72 mode: 3 cycles x 24 substeps = 72 total.
//======================================================

//-----------------ja_hysteresis--------------------
// Streaming Jiles-Atherton hysteresis with phase-locked bias oscillator.
// Computes 72 full JA substeps per sample (3 integer cycles, no bias leakage).
// M, H, and phase are fed back across samples for continuity.
// Supports bias asymmetry for 2nd harmonic warmth.
//
// #### Usage
//
// ```
// _ : ja_hysteresis(Ms, a, k, c, alpha, bias_level, bias_scale, bias_asym, diff_scale) : _
// ```
//
// Where:
//
// * Ms: saturation magnetization (default 320)
// * a: domain density parameter (default 720)
// * k: pinning/coercivity parameter (default 280)
// * c: reversibility ratio (default 0.18)
// * alpha: interdomain coupling (default 0.015)
// * bias_level: bias amplitude 0-1 (default 0.4)
// * bias_scale: bias multiplier (default 11.0)
// * bias_asym: bias asymmetry 0-0.5 for 2nd harmonic (default 0.0)
// * diff_scale: stabilization strength (default 1.0)
//
// #### Example
//
// ```
// process = _ : ja_hysteresis(320, 720, 280, 0.18, 0.015, 0.4, 11.0, 0.0, 1.0) : _;
// ```
//
// #### Test
//
// ```
// jah = library("jahysteresis.lib");
// ja_hysteresis_test = os.osc(100) * 0.5 : jah.ja_hysteresis(320, 720, 280, 0.18, 0.015, 0.4, 11.0, 0.0, 1.0);
// ```
//
// #### References
//
// * Jiles, D.C. and Atherton, D.L. (1986) "Theory of ferromagnetic hysteresis"
//-------------------------------------------------
ja_hysteresis(Ms, a_density, k_pinning, c_reversibility, alpha_coupling,
              bias_level, bias_scale, bias_asym, diff_scale, H_in) =
  (loop ~ (mem, mem, mem)) : ba.selector(3, 4) : *(inv_n)
with {
  // Derived constants
  Ms_safe    = max(Ms, 1e-6);
  alpha_norm = alpha_coupling;
  a_norm     = a_density / Ms_safe;
  inv_a_norm = 1.0 / max(a_norm, 1e-9);
  k_norm     = k_pinning / Ms_safe;
  c_norm     = c_reversibility;
  sigma      = 1e-3;

  // Smoothed bias parameters
  bias_amp   = bias_level * bias_scale : si.smoo;
  bias_asym_s = bias_asym : si.smoo;

  two_pi = 2.0 * ma.PI;
  substep_phase = two_pi / 24.0;
  inv_n = 1.0 / 72.0;

  wrap_2pi(p) = ba.if(p >= two_pi, p - two_pi, p);

  // Substep with phase tracking and bias asymmetry
  ja_substep_seq(M_prev, H_prev, H_audio, M_sum_prev, phase) =
    M_new, H_new, H_audio, M_sum_new, phase_wrapped
  with {
    midpoint = ma.frac((phase + substep_phase * 0.5) / two_pi) * two_pi;
    // Bias asymmetry: adds 2nd harmonic for warmth
    bias_offset = sin(midpoint) + bias_asym_s * sin(2.0 * midpoint);
    step_result = ja_substep(bias_offset, M_prev, H_prev, H_audio,
                             bias_amp, inv_a_norm, alpha_norm, k_norm, c_norm, diff_scale, sigma);
    M_new = ba.selector(0, 2, step_result);
    H_new = ba.selector(1, 2, step_result);
    M_sum_new = M_sum_prev + M_new;
    phase_advanced = phase + substep_phase;
    phase_wrapped = wrap_2pi(phase_advanced);
  };

  // 72 substeps via seq
  ja_loop_72(M_prev, H_prev, H_audio, phi_start) =
    M_prev, H_prev, H_audio, 0.0, phi_start : seq(i, 72, ja_substep_seq)
    <: ba.selector(0, 5), ba.selector(1, 5), ba.selector(4, 5), ba.selector(3, 5);

  // Main loop with M, H, and phase feedback
  loop(recM, recH, recPhi) = recM, recH, H_in, recPhi : ja_loop_72;
};

//================= FSM Channel Processing ===============
// Full Spectrum Magnetization channel with gain staging, drive, and mix.
//========================================================

// DC blocker (5 Hz highpass, Q=0.7071 Butterworth)
dc_blocker = fi.SVFTPT.HP2(5.0, 0.7071);

//-----------------lambda_sat--------------------
// Wavelength saturation (spectral tilt) filter.
// Simulates shorter wavelengths saturating harder on tape.
// HF boost before JA processing, HF cut after for balance.
//
// #### Usage
//
// ```
// _ : lambda_sat(alpha) : _
// ```
//
// Where:
//
// * alpha: tilt amount, -0.1 to +0.1 (0 = flat, + = HF boost)
//
// #### Example
//
// ```
// process = _ : lambda_sat(0.05) : _;
// ```
//-------------------------------------------------
lambda_sat(alpha) = fi.spectral_tilt(3, 200, 15000, alpha);

//-----------------fsm_channel--------------------
// Full Spectrum Magnetization channel with phase-locked Jiles-Atherton hysteresis.
// Applies input gain, drive, wavelength saturation, JA hysteresis (72 substeps),
// DC blocking, drive compensation, bias compensation, and output gain.
//
// #### Usage
//
// ```
// _ : fsm_channel(input_db, output_db, drive_db, mix,
//                  Ms, a, k, c, alpha, bias_level, bias_scale, bias_asym,
//                  lambda_tilt, diff_scale) : _
// ```
//
// Where:
//
// * input_db: front-end gain in dB
// * output_db: post-stage gain in dB
// * drive_db: pre-saturation drive in dB
// * mix: dry/wet blend from 0 (dry) to 1 (wet)
// * Ms, a, k, c, alpha: JA physics parameters
// * bias_level: bias amplitude 0-1
// * bias_scale: bias multiplier
// * bias_asym: bias asymmetry 0-0.5 for 2nd harmonic warmth
// * lambda_tilt: wavelength saturation -0.1 to +0.1
// * diff_scale: stabilization strength
//
// #### Example
//
// ```
// process = par(i, 2, fsm_channel(0, 0, 0, 1, 320, 720, 280, 0.18, 0.015, 0.4, 11, 0, 0, 1));
// ```
//
// #### Test
//
// ```
// jah = library("jahysteresis.lib");
// fsm_channel_test = os.osc(440) * 0.3 : jah.fsm_channel(0, 0, 6, 1, 320, 720, 280, 0.18, 0.015, 0.4, 11, 0, 0, 1);
// ```
//
// #### References
//
// * Jiles, D.C. and Atherton, D.L. (1986) "Theory of ferromagnetic hysteresis"
// * <https://github.com/Mando-369/FAUST_FSM_TAPE>
//-------------------------------------------------
fsm_channel(input_gain_db, output_gain_db, drive_db, mix_val,
             Ms, a_density, k_pinning, c_reversibility, alpha_coupling,
             bias_level, bias_scale, bias_asym, lambda_tilt, diff_scale) =
  ef.dryWetMixer(mix_val, wet_gained)
with {
  // Gains (smoothed)
  input_gain  = ba.db2linear(input_gain_db) : si.smoo;
  output_gain = ba.db2linear(output_gain_db) : si.smoo;
  drive_gain  = ba.db2linear(drive_db) : si.smoo;
  drive_comp  = (1.0 / drive_gain) * ba.db2linear(15.6);  // drive inverse + JA makeup

  // Smoothed bias for compensation calc
  bias_amp_s = bias_level * bias_scale : si.smoo;
  bias_asym_s = bias_asym : si.smoo;

  // Bias compensation (piecewise linear from measured data)
  // Reference: bias_amp=4.4 (bias_level=0.4, bias_scale=11) = 0dB
  bias_comp_db = ba.if(bias_amp_s < 4.4,
                       (bias_amp_s - 4.4) * 2.07,
                       (bias_amp_s - 4.4) * 1.003);
  bias_comp = ba.db2linear(bias_comp_db);

  // Asymmetry compensation (linear from 0dB at asym=0)
  // Measured: ~-3.6dB at asym=0.5
  asym_comp_db = bias_asym_s * (-7.2);
  asym_comp = ba.db2linear(asym_comp_db);

  // Tape stage
  fsm_stage(x) =
    x * input_gain
    : *(drive_gain)
    : lambda_sat(lambda_tilt)
    : ja_hysteresis(Ms, a_density, k_pinning, c_reversibility, alpha_coupling,
                    bias_level, bias_scale, bias_asym, diff_scale)
    : dc_blocker
    : *(drive_comp)
    : *(bias_comp)
    : *(asym_comp);

  wet_gained = fsm_stage : *(output_gain);
};

//-----------------fsm_channel_ui--------------------
// UI wrapper that binds sliders to the core `fsm_channel` parameters.
// Exposes all JA physics parameters for experimentation.
//
// #### Usage
//
// ```
// _ : fsm_channel_ui : _
// ```
//
// #### Example
//
// ```
// process = par(i, 2, fsm_channel_ui);
// ```
//
// #### Test
//
// ```
// jah = library("jahysteresis.lib");
// fsm_channel_ui_test = par(i, 2, jah.fsm_channel_ui);
// ```
//
// #### References
//
// * Jiles, D.C. and Atherton, D.L. (1986) "Theory of ferromagnetic hysteresis"
// * <https://github.com/Mando-369/FAUST_FSM_TAPE>
//-------------------------------------------------
fsm_channel_ui =
  fsm_channel(input_gain_db, output_gain_db, drive_db, mix,
               Ms, a_density, k_pinning, c_reversibility, alpha_coupling,
               bias_level, bias_scale, bias_asym, lambda_tilt, diff_scale)
with {
  // Group 1: GAIN
  input_gain_db  = hgroup("JA", hgroup("[01] GAIN", vslider("[0]Input [dB]", 0.0, -24.0, 24.0, 0.1)));
  output_gain_db = hgroup("JA", hgroup("[01] GAIN", vslider("[1]Output [dB]", 0.0, -24.0, 24.0, 0.1)));
  drive_db       = hgroup("JA", hgroup("[01] GAIN", vslider("[2]Drive [dB]", 0.0, -18.0, 29.0, 0.1)));
  mix            = hgroup("JA", hgroup("[01] GAIN", vslider("[3]Mix", 1.0, 0.0, 1.0, 0.01)));

  // Group 2: BIAS - asymmetry adds 2nd harmonic (0.5 max before inversion)
  bias_level = hgroup("JA", hgroup("[02] BIAS", vslider("[0]Level", BIAS_LEVEL_DEFAULT, 0.01, 1.0, 0.01)));
  bias_scale = hgroup("JA", hgroup("[02] BIAS", vslider("[1]Scale", BIAS_SCALE_DEFAULT, 1.0, 100.0, 0.1)));
  bias_asym  = hgroup("JA", hgroup("[02] BIAS", vslider("[2]Asym", BIAS_ASYM_DEFAULT, 0.0, 0.5, 0.01)));

  // Group 3: TAPE - wavelength saturation (λ response)
  // Tilt: 0 = flat, +0.1 = HF boost, -0.1 = HF cut
  lambda_tilt = hgroup("JA", hgroup("[03] TAPE", vslider("[0]λ Tilt", LAMBDA_TILT_DEFAULT, -0.1, 0.1, 0.001)));

  // Group 4: STABILIZATION
  diff_scale = hgroup("JA", hgroup("[04] STAB", vslider("[0]Diff Scale", DIFF_SCALE_DEFAULT, 0.0, 4.0, 0.01)));

  // Group 5: PHYSICS
  Ms              = hgroup("JA", hgroup("[05] PHYSICS", vslider("[0]Ms", MS_DEFAULT, 100.0, 1000.0, 1.0)));
  a_density       = hgroup("JA", hgroup("[05] PHYSICS", vslider("[1]a", A_DEFAULT, 100.0, 2000.0, 1.0)));
  k_pinning       = hgroup("JA", hgroup("[05] PHYSICS", vslider("[2]k", K_DEFAULT, 50.0, 1000.0, 1.0)));
  c_reversibility = hgroup("JA", hgroup("[05] PHYSICS", vslider("[3]c", C_DEFAULT, 0.0, 1.0, 0.01)));
  alpha_coupling  = hgroup("JA", hgroup("[05] PHYSICS", vslider("[4]alpha", ALPHA_DEFAULT, 0.001, 0.1, 0.001)));
};
