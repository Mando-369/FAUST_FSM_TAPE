    2.9000000000e+01,    2.9000000000e+01,    2.9000000000e+01,    2.9000000000e+01,
    2.9000000000e+01,    2.9000000000e+01,    2.9000000000e+01,    2.9000000000e+01,
    2.9000000000e+01,    2.9000000000e+01,    2.9000000000e+01,    2.9000000000e+01,
    2.9000000000e+01};

// 3D index computation: (mi * H_SIZE + hi) * B_SIZE + bi
ja_lut_k29_idx3(mi, hi, bi) = (mi * ja_lut_k29_h_size + hi) * ja_lut_k29_b_size + bi;

// Normalize M to [0, 1] range
ja_lut_k29_m_norm(m) = (m - ja_lut_k29_m_min) / (ja_lut_k29_m_max - ja_lut_k29_m_min);

// Normalize H to [0, 1] range
ja_lut_k29_h_norm(h) = (h - ja_lut_k29_h_min) / (ja_lut_k29_h_max - ja_lut_k29_h_min);

// Normalize bias to [0, 1] range
ja_lut_k29_b_norm(b) = (b - ja_lut_k29_b_min) / (ja_lut_k29_b_max - ja_lut_k29_b_min);

// Trilinear interpolation lookup for M_end (8 corners)
ja_lookup_m_end_k29(m, h, b) = result
with {
    m_n = max(0.0, min(1.0, ja_lut_k29_m_norm(m)));
    h_n = max(0.0, min(1.0, ja_lut_k29_h_norm(h)));
    b_n = max(0.0, min(1.0, ja_lut_k29_b_norm(b)));
    
    // Scale to grid, clamp to valid range [0, size-2]
    m_scaled = max(0.0, min(m_n * (ja_lut_k29_m_size - 1), ja_lut_k29_m_size - 1.0001));
    h_scaled = max(0.0, min(h_n * (ja_lut_k29_h_size - 1), ja_lut_k29_h_size - 1.0001));
    b_scaled = max(0.0, min(b_n * (ja_lut_k29_b_size - 1), ja_lut_k29_b_size - 1.0001));
    
    // Base index and fractional part
    mi = floor(m_scaled);
    hi = floor(h_scaled);
    bi = floor(b_scaled);
    mt = m_scaled - mi;
    ht = h_scaled - hi;
    bt = b_scaled - bi;
    
    // Fetch 8 corners (2x2x2)
    fetch(dm, dh, db) = ja_lut_k29_m_end, ja_lut_k29_idx3(mi + dm, hi + dh, bi + db) : rdtable;
    p000 = fetch(0, 0, 0); p001 = fetch(0, 0, 1);
    p010 = fetch(0, 1, 0); p011 = fetch(0, 1, 1);
    p100 = fetch(1, 0, 0); p101 = fetch(1, 0, 1);
    p110 = fetch(1, 1, 0); p111 = fetch(1, 1, 1);
    
    // Trilinear: interpolate along bias first, then H, then M
    lerp(t, a, b) = a + t * (b - a);
    p00 = lerp(bt, p000, p001);
    p01 = lerp(bt, p010, p011);
    p10 = lerp(bt, p100, p101);
    p11 = lerp(bt, p110, p111);
    p0 = lerp(ht, p00, p01);
    p1 = lerp(ht, p10, p11);
    result = lerp(mt, p0, p1);
};

// Trilinear interpolation lookup for sumM_rest (8 corners)
ja_lookup_sum_m_rest_k29(m, h, b) = result
with {
    m_n = max(0.0, min(1.0, ja_lut_k29_m_norm(m)));
    h_n = max(0.0, min(1.0, ja_lut_k29_h_norm(h)));
    b_n = max(0.0, min(1.0, ja_lut_k29_b_norm(b)));
    
    // Scale to grid, clamp to valid range [0, size-2]
    m_scaled = max(0.0, min(m_n * (ja_lut_k29_m_size - 1), ja_lut_k29_m_size - 1.0001));
    h_scaled = max(0.0, min(h_n * (ja_lut_k29_h_size - 1), ja_lut_k29_h_size - 1.0001));
    b_scaled = max(0.0, min(b_n * (ja_lut_k29_b_size - 1), ja_lut_k29_b_size - 1.0001));
    
    // Base index and fractional part
    mi = floor(m_scaled);
    hi = floor(h_scaled);
    bi = floor(b_scaled);
    mt = m_scaled - mi;
    ht = h_scaled - hi;
    bt = b_scaled - bi;
    
    // Fetch 8 corners (2x2x2)
    fetch(dm, dh, db) = ja_lut_k29_sum_m_rest, ja_lut_k29_idx3(mi + dm, hi + dh, bi + db) : rdtable;
    p000 = fetch(0, 0, 0); p001 = fetch(0, 0, 1);
    p010 = fetch(0, 1, 0); p011 = fetch(0, 1, 1);
    p100 = fetch(1, 0, 0); p101 = fetch(1, 0, 1);
    p110 = fetch(1, 1, 0); p111 = fetch(1, 1, 1);
    
    // Trilinear: interpolate along bias first, then H, then M
    lerp(t, a, b) = a + t * (b - a);
    p00 = lerp(bt, p000, p001);
    p01 = lerp(bt, p010, p011);
    p10 = lerp(bt, p100, p101);
    p11 = lerp(bt, p110, p111);
    p0 = lerp(ht, p00, p01);
    p1 = lerp(ht, p10, p11);
    result = lerp(mt, p0, p1);
};
