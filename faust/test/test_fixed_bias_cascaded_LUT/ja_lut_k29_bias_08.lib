// 2D index computation
ja_lut_k29_bias_08_idx(m_idx, h_idx) = m_idx * ja_lut_k29_bias_08_h_size + h_idx;

// Normalize M to [0, 1] range
ja_lut_k29_bias_08_m_norm(m) = (m - ja_lut_k29_bias_08_m_min) / (ja_lut_k29_bias_08_m_max - ja_lut_k29_bias_08_m_min);

// Normalize H to [0, 1] range
ja_lut_k29_bias_08_h_norm(h) = (h - ja_lut_k29_bias_08_h_min) / (ja_lut_k29_bias_08_h_max - ja_lut_k29_bias_08_h_min);

// Bilinear interpolation lookup for M_end (4 points)
ja_lookup_m_end_k29_bias_08(m, h) = result
with {
    m_n = max(0.0, min(1.0, ja_lut_k29_bias_08_m_norm(m)));
    h_n = max(0.0, min(1.0, ja_lut_k29_bias_08_h_norm(h)));
    
    // Scale to grid, clamp to valid bilinear range [0, size-2]
    m_scaled = max(0.0, min(m_n * (ja_lut_k29_bias_08_m_size - 1), ja_lut_k29_bias_08_m_size - 1.0001));
    h_scaled = max(0.0, min(h_n * (ja_lut_k29_bias_08_h_size - 1), ja_lut_k29_bias_08_h_size - 1.0001));
    
    // Base index and fractional part
    mi = floor(m_scaled);
    hi = floor(h_scaled);
    mt = m_scaled - mi;
    ht = h_scaled - hi;
    
    // Fetch 4 corner points
    fetch(dm, dh) = ja_lut_k29_bias_08_m_end, ja_lut_k29_bias_08_idx(mi + dm, hi + dh) : rdtable;
    p00 = fetch(0, 0); p01 = fetch(0, 1);
    p10 = fetch(1, 0); p11 = fetch(1, 1);
    
    // Bilinear interpolation
    result = (1.0 - mt) * ((1.0 - ht) * p00 + ht * p01) + mt * ((1.0 - ht) * p10 + ht * p11);
};

// Bilinear interpolation lookup for sumM_rest (4 points)
ja_lookup_sum_m_rest_k29_bias_08(m, h) = result
with {
    m_n = max(0.0, min(1.0, ja_lut_k29_bias_08_m_norm(m)));
    h_n = max(0.0, min(1.0, ja_lut_k29_bias_08_h_norm(h)));
    
    // Scale to grid, clamp to valid bilinear range [0, size-2]
    m_scaled = max(0.0, min(m_n * (ja_lut_k29_bias_08_m_size - 1), ja_lut_k29_bias_08_m_size - 1.0001));
    h_scaled = max(0.0, min(h_n * (ja_lut_k29_bias_08_h_size - 1), ja_lut_k29_bias_08_h_size - 1.0001));
    
    // Base index and fractional part
    mi = floor(m_scaled);
    hi = floor(h_scaled);
    mt = m_scaled - mi;
    ht = h_scaled - hi;
    
    // Fetch 4 corner points
    fetch(dm, dh) = ja_lut_k29_bias_08_sum_m_rest, ja_lut_k29_bias_08_idx(mi + dm, hi + dh) : rdtable;
    p00 = fetch(0, 0); p01 = fetch(0, 1);
    p10 = fetch(1, 0); p11 = fetch(1, 1);
    
    // Bilinear interpolation
    result = (1.0 - mt) * ((1.0 - ht) * p00 + ht * p01) + mt * ((1.0 - ht) * p10 + ht * p11);
};
