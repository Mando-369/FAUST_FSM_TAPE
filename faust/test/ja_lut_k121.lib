    -1.8967658369e+00,    -1.6093367884e+00,    -1.3219141171e+00,    -1.0344942129e+00,
    -7.4707346444e-01,    -4.5964825934e-01,    -1.7221498536e-01,    1.1522996895e-01,
    4.0269021339e-01,    6.9016935534e-01,    9.7767099897e-01,    1.2651987444e+00,
    1.5527561869e+00,    1.8403469162e+00,    2.1279745155e+00,    2.4156425606e+00,
    2.7033546196e+00,    2.9911142513e+00,    3.2789250052e+00,    3.5667904201e+00,
    3.8547140233e+00,    4.1426993304e+00,    4.4307498436e+00,    4.7188690515e+00,
    5.0070604282e+00,    5.2953274323e+00,    5.5836735060e+00,    5.8721020746e+00,
    6.1606165453e+00,    6.4492203067e+00,    6.7379167278e+00,    7.0267091572e+00,
    7.3156009221e+00,    7.6045953278e+00,    7.8936956565e+00,    8.1829051668e+00,
    8.4722270925e+00,    8.7616646421e+00,    9.0512209977e+00,    9.3408993144e+00,
    9.6307027190e+00,    9.9206343099e+00,    1.0210697155e+01,    1.0500894293e+01,
    1.0791228731e+01,    1.1081703441e+01,    1.1372321367e+01,    1.1663085414e+01,
    1.1953998456e+01,    1.2245063329e+01,    1.2536282834e+01,    1.2827659733e+01,
    1.3119196753e+01,    1.3410896577e+01,    1.3702761852e+01,    1.3994795184e+01,
    1.4286999135e+01,    1.4579376228e+01,    1.4871928938e+01,    1.5164659701e+01,
    1.5457570905e+01,    1.5750664892e+01,    1.6043943958e+01,    1.6337410352e+01,
    1.6631066274e+01,    1.6924913874e+01,    1.7218955254e+01,    1.7513192463e+01,
    1.7807627499e+01,    1.8102262308e+01,    1.8397098781e+01,    1.8692138756e+01,
    1.8987384015e+01};

// 2D index computation
ja_lut_k121_idx(m_idx, h_idx) = m_idx * ja_lut_k121_h_size + h_idx;

// Normalize M to [0, 1] range
ja_lut_k121_m_norm(m) = (m - ja_lut_k121_m_min) / (ja_lut_k121_m_max - ja_lut_k121_m_min);

// Normalize H to [0, 1] range
ja_lut_k121_h_norm(h) = (h - ja_lut_k121_h_min) / (ja_lut_k121_h_max - ja_lut_k121_h_min);

// 1D Catmull-Rom interpolation: p0,p1,p2,p3 are 4 consecutive points, t in [0,1]
ja_catmull_rom_k121(p0, p1, p2, p3, t) = 0.5 * (
    2.0*p1 +
    (-p0 + p2) * t +
    (2.0*p0 - 5.0*p1 + 4.0*p2 - p3) * t * t +
    (-p0 + 3.0*p1 - 3.0*p2 + p3) * t * t * t
);

// Separable Catmull-Rom interpolation lookup for M_end
ja_lookup_m_end_k121(m, h) = result
with {
    m_n = max(0.0, min(1.0, ja_lut_k121_m_norm(m)));
    h_n = max(0.0, min(1.0, ja_lut_k121_h_norm(h)));
    
    m_scaled = m_n * (ja_lut_k121_m_size - 1);
    h_scaled = h_n * (ja_lut_k121_h_size - 1);
    
    m_idx = int(floor(m_scaled));
    h_idx = int(floor(h_scaled));
    
    m_frac = m_scaled - float(m_idx);
    h_frac = h_scaled - float(h_idx);
    
    // Clamp indices for 4x4 Catmull-Rom
    m0 = max(0, m_idx - 1);
    m1 = max(0, min(m_idx, ja_lut_k121_m_size - 1));
    m2 = max(0, min(m_idx + 1, ja_lut_k121_m_size - 1));
    m3 = min(m_idx + 2, ja_lut_k121_m_size - 1);
    
    h0 = max(0, h_idx - 1);
    h1 = max(0, min(h_idx, ja_lut_k121_h_size - 1));
    h2 = max(0, min(h_idx + 1, ja_lut_k121_h_size - 1));
    h3 = min(h_idx + 2, ja_lut_k121_h_size - 1);
    
    // Fetch 16 points (4x4 grid)
    v00 = ja_lut_k121_m_end, ja_lut_k121_idx(m0, h0) : rdtable;
    v01 = ja_lut_k121_m_end, ja_lut_k121_idx(m0, h1) : rdtable;
    v02 = ja_lut_k121_m_end, ja_lut_k121_idx(m0, h2) : rdtable;
    v03 = ja_lut_k121_m_end, ja_lut_k121_idx(m0, h3) : rdtable;
    v10 = ja_lut_k121_m_end, ja_lut_k121_idx(m1, h0) : rdtable;
    v11 = ja_lut_k121_m_end, ja_lut_k121_idx(m1, h1) : rdtable;
    v12 = ja_lut_k121_m_end, ja_lut_k121_idx(m1, h2) : rdtable;
    v13 = ja_lut_k121_m_end, ja_lut_k121_idx(m1, h3) : rdtable;
    v20 = ja_lut_k121_m_end, ja_lut_k121_idx(m2, h0) : rdtable;
    v21 = ja_lut_k121_m_end, ja_lut_k121_idx(m2, h1) : rdtable;
    v22 = ja_lut_k121_m_end, ja_lut_k121_idx(m2, h2) : rdtable;
    v23 = ja_lut_k121_m_end, ja_lut_k121_idx(m2, h3) : rdtable;
    v30 = ja_lut_k121_m_end, ja_lut_k121_idx(m3, h0) : rdtable;
    v31 = ja_lut_k121_m_end, ja_lut_k121_idx(m3, h1) : rdtable;
    v32 = ja_lut_k121_m_end, ja_lut_k121_idx(m3, h2) : rdtable;
    v33 = ja_lut_k121_m_end, ja_lut_k121_idx(m3, h3) : rdtable;
    
    // Interpolate 4 columns along H axis
    col0 = ja_catmull_rom_k121(v00, v01, v02, v03, h_frac);
    col1 = ja_catmull_rom_k121(v10, v11, v12, v13, h_frac);
    col2 = ja_catmull_rom_k121(v20, v21, v22, v23, h_frac);
    col3 = ja_catmull_rom_k121(v30, v31, v32, v33, h_frac);
    
    // Interpolate along M axis
    result = ja_catmull_rom_k121(col0, col1, col2, col3, m_frac);
};

// Separable Catmull-Rom interpolation lookup for sumM_rest
ja_lookup_sum_m_rest_k121(m, h) = result
with {
    m_n = max(0.0, min(1.0, ja_lut_k121_m_norm(m)));
    h_n = max(0.0, min(1.0, ja_lut_k121_h_norm(h)));
    
    m_scaled = m_n * (ja_lut_k121_m_size - 1);
    h_scaled = h_n * (ja_lut_k121_h_size - 1);
    
    m_idx = int(floor(m_scaled));
    h_idx = int(floor(h_scaled));
    
    m_frac = m_scaled - float(m_idx);
    h_frac = h_scaled - float(h_idx);
    
    // Clamp indices for 4x4 Catmull-Rom
    m0 = max(0, m_idx - 1);
    m1 = max(0, min(m_idx, ja_lut_k121_m_size - 1));
    m2 = max(0, min(m_idx + 1, ja_lut_k121_m_size - 1));
    m3 = min(m_idx + 2, ja_lut_k121_m_size - 1);
    
    h0 = max(0, h_idx - 1);
    h1 = max(0, min(h_idx, ja_lut_k121_h_size - 1));
    h2 = max(0, min(h_idx + 1, ja_lut_k121_h_size - 1));
    h3 = min(h_idx + 2, ja_lut_k121_h_size - 1);
    
    // Fetch 16 points (4x4 grid)
    v00 = ja_lut_k121_sum_m_rest, ja_lut_k121_idx(m0, h0) : rdtable;
    v01 = ja_lut_k121_sum_m_rest, ja_lut_k121_idx(m0, h1) : rdtable;
    v02 = ja_lut_k121_sum_m_rest, ja_lut_k121_idx(m0, h2) : rdtable;
    v03 = ja_lut_k121_sum_m_rest, ja_lut_k121_idx(m0, h3) : rdtable;
    v10 = ja_lut_k121_sum_m_rest, ja_lut_k121_idx(m1, h0) : rdtable;
    v11 = ja_lut_k121_sum_m_rest, ja_lut_k121_idx(m1, h1) : rdtable;
    v12 = ja_lut_k121_sum_m_rest, ja_lut_k121_idx(m1, h2) : rdtable;
    v13 = ja_lut_k121_sum_m_rest, ja_lut_k121_idx(m1, h3) : rdtable;
    v20 = ja_lut_k121_sum_m_rest, ja_lut_k121_idx(m2, h0) : rdtable;
    v21 = ja_lut_k121_sum_m_rest, ja_lut_k121_idx(m2, h1) : rdtable;
    v22 = ja_lut_k121_sum_m_rest, ja_lut_k121_idx(m2, h2) : rdtable;
    v23 = ja_lut_k121_sum_m_rest, ja_lut_k121_idx(m2, h3) : rdtable;
    v30 = ja_lut_k121_sum_m_rest, ja_lut_k121_idx(m3, h0) : rdtable;
    v31 = ja_lut_k121_sum_m_rest, ja_lut_k121_idx(m3, h1) : rdtable;
    v32 = ja_lut_k121_sum_m_rest, ja_lut_k121_idx(m3, h2) : rdtable;
    v33 = ja_lut_k121_sum_m_rest, ja_lut_k121_idx(m3, h3) : rdtable;
    
    // Interpolate 4 columns along H axis
    col0 = ja_catmull_rom_k121(v00, v01, v02, v03, h_frac);
    col1 = ja_catmull_rom_k121(v10, v11, v12, v13, h_frac);
    col2 = ja_catmull_rom_k121(v20, v21, v22, v23, h_frac);
    col3 = ja_catmull_rom_k121(v30, v31, v32, v33, h_frac);
    
    // Interpolate along M axis
    result = ja_catmull_rom_k121(col0, col1, col2, col3, m_frac);
};
